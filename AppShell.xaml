<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MiCachito.Mobile.Views"
    x:Class="MiCachito.Mobile.AppShell"
    FlyoutBehavior="Disabled">

    <TabBar>

        <ShellContent
            Title="Vender"
            Icon="tab_vender"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Gestion"
            Icon="tab_gestion"
            ContentTemplate="{DataTemplate views:GestionPage}" />

        <ShellContent
            Title="Expendios"
            Icon="tab_expendios"
            ContentTemplate="{DataTemplate views:ExpendiosPage}" />

        <ShellContent
            Title="Cuenta"
            Icon="tab_cuenta"
            ContentTemplate="{DataTemplate views:CuentaPage}" />

    </TabBar>

</Shell>