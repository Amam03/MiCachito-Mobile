<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiCachito.Mobile.Views.LoginPage"
    Title="Login">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="Mi Cachito"
            FontSize="32"
            HorizontalOptions="Center"/>

        <Entry
            Placeholder="Usuario"
            Text="{Binding Usuario}" />

        <Entry
            Placeholder="Contraseña"
            IsPassword="True"
            Text="{Binding Password}" />

        <Button
            Text="Ingresar"
            Command="{Binding IngresarCommand}" />

        <Label
            Text="{Binding Mensaje}"
            FontSize="16"
            HorizontalOptions="Center"/>

    </VerticalStackLayout>

</ContentPage>