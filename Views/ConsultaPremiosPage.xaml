<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MiCachito.Mobile.Controls"
    x:Class="MiCachito.Mobile.Views.ConsultaPremiosPage"
    Title="Consulta de Premios"
    BackgroundColor="{StaticResource McFieldBg}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ============ HEADER morado (patron LOTENAL) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">

                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#x2190;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Consulta de Premios"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </Grid>
        </Border>

        <!-- ============ CUERPO: camara integrada + entrada manual ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,24" Spacing="16">

                <!-- Camara integrada: preview en vivo + deteccion de QR -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource McPremioPanelOscuro}"
                    HeightRequest="260"
                    Padding="0">
                    <Grid>
                        <controls:CameraScannerView
                            x:Name="Escaner"
                            DetectionCommand="{Binding CodigoDetectadoCommand}"
                            IsScanning="{Binding CamaraLista}"
                            ForzarCaptura="{Binding ForzarCaptura}"
                            NoDetectadoCommand="{Binding SinDeteccionCommand}"
                            TorchOn="{Binding LinternaEncendida}" />
                        <!-- Marco de escaneo encima del preview -->
                        <Border
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource McLotenalHeader}"
                            WidthRequest="180"
                            HeightRequest="180"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True" />
                        <!-- Linterna: boton compacto sobre la esquina del preview -->
                        <Border
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#B3000000"
                            WidthRequest="36"
                            HeightRequest="36"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,10,10,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleLinternaCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="&#x26A1;"
                                FontSize="16"
                                TextColor="{StaticResource White}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <!-- Mensaje cuando falta el permiso -->
                        <Label
                            Text="Permiso de camara no concedido. Puedes capturar el codigo a mano."
                            TextColor="{StaticResource White}"
                            FontSize="13"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Margin="20,0,20,0"
                            IsVisible="{Binding PermisoDenegado}" />
                    </Grid>
                </Border>

                <!-- Boton principal: capturar el QR del boleto -->
                <Button
                    Text="Capturar QR"
                    Command="{Binding CapturarQrCommand}"
                    BackgroundColor="{StaticResource McLotenalHeader}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    HeightRequest="48"
                    CornerRadius="10" />

                <!-- Aviso de error (codigo invalido / permiso); vacio = invisible -->
                <Label
                    Text="{Binding Aviso}"
                    TextColor="{StaticResource McPremioRojo}"
                    FontSize="13"
                    HorizontalTextAlignment="Center" />

                <!-- Entrada manual (via de prueba en emulador) -->
                <Label
                    Text="O captura el codigo a mano:"
                    FontSize="13"
                    TextColor="{StaticResource McGrayText}" />
                <Entry
                    x:Name="CampoManual"
                    Text="{Binding CodigoManual}"
                    Placeholder="34 o 35 digitos / SE051B032127"
                    Keyboard="Plain"
                    ReturnType="Done"
                    ReturnCommand="{Binding ConsultarManualCommand}"
                    ClearButtonVisibility="WhileEditing" />
                <Button
                    Text="Consultar"
                    Command="{Binding ConsultarManualCommand}"
                    BackgroundColor="{StaticResource McGreenAccept}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    HeightRequest="44"
                    CornerRadius="10" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
