<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.SorteosPage"
    Title="Sorteos"
    BackgroundColor="{StaticResource McFieldBg}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ HEADER morado + selector FIJADO (mockup 4) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- Header: back + titulo -->
                <Grid Grid.Row="0" ColumnDefinitions="44,*,44" VerticalOptions="Center">

                    <Border
                        Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="&#x2190;"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource White}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="Sorteos Celebrados"
                        FontSize="20"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center" />

                </Grid>

                <!-- Selector de sorteo (fijado arriba, abre el dropdown) -->
                <Border
                    Grid.Row="1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Stroke="#D9D2FF"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,12,14,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDropdownCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{Binding SelectorText}"
                            FontSize="14"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            TextColor="{StaticResource McTextDark}"
                            VerticalOptions="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectorFlecha}"
                            FontSize="11"
                            TextColor="{StaticResource McLotenalHeader}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ============ CONTENIDO (solo con sorteo seleccionado) ============ -->
        <ScrollView Grid.Row="1" IsVisible="{Binding HaySeleccion}">
            <VerticalStackLayout Padding="16,14,16,20" Spacing="12">
                <!-- ===== Resumen (mockup 4.1): 3 columnas ===== -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,12,14,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Resumen" FontSize="13" FontAttributes="Bold"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource McLotenalHeader}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Ventas" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding VentasText}" FontSize="15"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Pagos realizados" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding PagosRealizadosText}" FontSize="15"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                            <StackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Saldo a pagar" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding SaldoAPagarText}" FontSize="15"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Entregas y Devoluciones (colapsable) ===== -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,12,14,12">
                    <VerticalStackLayout Spacing="10">

                        <!-- Encabezado: titulo + flecha -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleEntregasCommand}" />
                            </Grid.GestureRecognizers>
                            <Label
                                Grid.Column="0"
                                Text="Entregas y Devoluciones"
                                FontSize="15" FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource McTextDark}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding FlechaEntregas}"
                                FontSize="12"
                                TextColor="{StaticResource McLotenalHeader}"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Fila: Entregas | Devolución | Ventas -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Entregas:" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TotalEntregasText}" FontSize="14"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Devolución:" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding DevolucionText}" FontSize="14"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                            <StackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Ventas:" FontSize="11" TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding VentasEntregasText}" FontSize="14"
                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalTextAlignment="Center" />
                            </StackLayout>
                        </Grid>

                        <!-- Tarjetas de folios (expandido) -->
                        <VerticalStackLayout
                            IsVisible="{Binding EntregasExpandido}"
                            BindableLayout.ItemsSource="{Binding Info.Entregas}"
                            Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="entities:FolioEntregaSorteo">
                                    <Border
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource McDivider}"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="12,10,12,10">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Folio}" FontSize="13"
                                                       FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource McTextDark}" />
                                                <Label Text="{Binding Series}" Grid.Column="1" FontSize="11"
                                                       TextColor="{StaticResource McGrayText}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
                                                <StackLayout Grid.Column="0" Spacing="1">
                                                    <Label Text="Subtotal" FontSize="10" TextColor="{StaticResource McGrayText}" />
                                                    <Label Text="{Binding Subtotal, StringFormat='${0:0.00}'}" FontSize="12"
                                                           FontAttributes="Bold" TextColor="{StaticResource McTextDark}" />
                                                </StackLayout>
                                                <StackLayout Grid.Column="1" Spacing="1">
                                                    <Label Text="ISR" FontSize="10" TextColor="{StaticResource McGrayText}" />
                                                    <Label Text="{Binding Isr, StringFormat='${0:0.00}'}" FontSize="12"
                                                           TextColor="{StaticResource McTextDark}" />
                                                </StackLayout>
                                                <StackLayout Grid.Column="2" Spacing="1">
                                                    <Label Text="Comisión" FontSize="10" TextColor="{StaticResource McGrayText}" />
                                                    <Label Text="{Binding Comision, StringFormat='${0:0.00}'}" FontSize="12"
                                                           TextColor="{StaticResource McTextDark}" />
                                                </StackLayout>
                                                <StackLayout Grid.Column="3" Spacing="1">
                                                    <Label Text="FDA" FontSize="10" TextColor="{StaticResource McGrayText}"
                                                           HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding Fda, StringFormat='${0:0.00}'}" FontSize="12"
                                                           TextColor="{StaticResource McTextDark}"
                                                           HorizontalTextAlignment="End" />
                                                </StackLayout>
                                            </Grid>
                                            <Label Text="{Binding Total, StringFormat='Total: ${0:0.00}'}"
                                                   FontSize="13" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource McLotenalHeader}"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ===== Pagos Realizados (colapsable) ===== -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,12,14,12">
                    <VerticalStackLayout Spacing="10">

                        <!-- Encabezado: titulo + flecha -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePagosCommand}" />
                            </Grid.GestureRecognizers>
                            <Label
                                Grid.Column="0"
                                Text="Pagos Realizados"
                                FontSize="15" FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource McTextDark}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding FlechaPagos}"
                                FontSize="12"
                                TextColor="{StaticResource McLotenalHeader}"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Total pagado -->
                        <Label Text="{Binding TotalPagadoText, StringFormat='Total: {0}'}"
                               FontSize="14" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource McTextDark}"
                               HorizontalTextAlignment="Center" />

                        <!-- Tabla de pagos (expandido) -->
                        <Border
                            IsVisible="{Binding PagosExpandido}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource McFieldBg}"
                            Padding="10,8,10,8">
                            <Grid RowDefinitions="Auto,*">

                                <!-- Encabezados de columnas -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="Fecha" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource McGrayText}" />
                                    <Label Grid.Column="1" Text="Folio" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource McGrayText}" />
                                    <Label Grid.Column="2" Text="Monto ($)" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource McGrayText}"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="Tipo" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource McGrayText}"
                                           HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- Filas de pagos -->
                                <VerticalStackLayout
                                    Grid.Row="1"
                                    BindableLayout.ItemsSource="{Binding Info.Pagos}"
                                    Spacing="6"
                                    Margin="0,8,0,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="entities:PagoSorteo">
                                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
                                                <Label Grid.Column="0" Text="{Binding Fecha}" FontSize="12"
                                                       TextColor="{StaticResource McTextDark}" />
                                                <Label Grid.Column="1" Text="{Binding Folio}" FontSize="12"
                                                       TextColor="{StaticResource McTextDark}" />
                                                <Label Grid.Column="2" Text="{Binding Monto, StringFormat='${0:0.00}'}"
                                                       FontSize="12" TextColor="{StaticResource McTextDark}"
                                                       HorizontalTextAlignment="End" />
                                                <Label Grid.Column="3" Text="{Binding Tipo}" FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource McLotenalHeader}"
                                                       HorizontalTextAlignment="End" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ MENSAJE estado inicial (sin selección) ============ -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding SinSeleccion}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            BackgroundColor="{StaticResource White}"
            Padding="20"
            Margin="16,20,16,0"
            HorizontalOptions="Fill"
            VerticalOptions="Start">
            <Label
                Text="Selecciona un sorteo para ver su información."
                FontSize="14"
                TextColor="{StaticResource McGrayText}"
                HorizontalTextAlignment="Center" />
        </Border>

        <!-- ============ DROPDOWN overlay (lista de celebrados) ============ -->
        <Grid
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding DropdownVisible}"
            BackgroundColor="{StaticResource McScrimBlack55}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarDropdownCommand}" />
            </Grid.GestureRecognizers>

            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource White}"
                Margin="16,0,16,0"
                VerticalOptions="Center"
                InputTransparent="False">
                <Grid RowDefinitions="Auto,*">
                    <Label
                        Grid.Row="0"
                        Text="Sorteos Celebrados"
                        FontSize="15" FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource McLotenalHeader}"
                        Padding="14,12,0,8" />
                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding Sorteos}"
                        SelectionMode="None"
                        MaximumHeightRequest="420">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:SorteoActivoLotenal">
                                <Grid Padding="14,10,14,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarSorteoCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <StackLayout Spacing="1">
                                        <Label Text="{Binding NombreCorto}"
                                               FontSize="14" FontAttributes="Bold"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource McTextDark}" />
                                        <Label Text="{Binding FechaLarga}"
                                               FontSize="12"
                                               TextColor="{StaticResource McGrayText}" />
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
