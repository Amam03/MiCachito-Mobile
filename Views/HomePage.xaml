<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiCachito.Mobile.Views.HomePage"
    Title="Mi Cachito"
    BackgroundColor="{StaticResource White}">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <!-- === Botones Vender === -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="14"
            VerticalOptions="Start"
            Margin="0,10,0,0">

            <!-- Sr.B. LOTENAL -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McLotenal}"
                HeightRequest="64"
                Padding="20,0">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label Grid.Row="0"
                           Text="Sr.B."
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="LOTENAL"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Sorteos Tec -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McSorteosTec}"
                HeightRequest="64"
                Padding="20,0">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label Grid.Row="0"
                           Text="Sorteos"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="Tec"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Tiempo Aire -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McTiempoAire}"
                HeightRequest="64"
                Padding="20,0">
                <Label
                    Text="Tiempo Aire"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

        </VerticalStackLayout>

        <!-- === Cerrar sesion (preservado) === -->
        <Button
            Grid.Row="1"
            Text="Cerrar sesion"
            Command="{Binding CerrarSesionCommand}"
            BackgroundColor="Transparent"
            TextColor="{StaticResource McPlaceholder}"
            FontSize="14"
            BorderWidth="0"
            Margin="0,0,0,5" />

    </Grid>

</ContentPage>