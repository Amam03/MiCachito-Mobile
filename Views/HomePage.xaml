<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiCachito.Mobile.Views.HomePage"
    Title="Vender"
    BackgroundColor="{StaticResource White}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ Encabezado: Saldo (patron Gestion, mockup 2) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            HeightRequest="64"
            Padding="20,0">
            <StackLayout
                Orientation="Horizontal"
                Spacing="6"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="Saldo:"
                    FontSize="18"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding Saldo}"
                    FontSize="18"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource McGesSaldoVerde}"
                    VerticalOptions="Center" />
            </StackLayout>
        </Border>

        <!-- === Botones Vender === -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="14"
            VerticalOptions="Start"
            Padding="20,14,20,0">

            <!-- LOTENAL -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McLotenal}"
                HeightRequest="64"
                Padding="20,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding LotenalCommand}" />
                </Border.GestureRecognizers>
                <Label
                    Text="LOTENAL"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Sorteos Tec -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McSorteosTec}"
                HeightRequest="64"
                Padding="20,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding SorteosTecCommand}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                    <Label Grid.Row="0"
                           Text="Sorteos"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                    <Label Grid.Row="1"
                           Text="Tec"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

            <!-- Tiempo Aire -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{StaticResource McTiempoAire}"
                HeightRequest="64"
                Padding="20,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding TiempoAireCommand}" />
                </Border.GestureRecognizers>
                <Label
                    Text="Tiempo Aire"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

        </VerticalStackLayout>

        <!-- === Cerrar sesion (preservado) === -->
        <Button
            Grid.Row="2"
            Text="Cerrar sesion"
            Command="{Binding CerrarSesionCommand}"
            BackgroundColor="Transparent"
            TextColor="{StaticResource McPlaceholder}"
            FontSize="14"
            BorderWidth="0"
            HorizontalOptions="Center"
            Margin="0,0,0,5" />

    </Grid>

</ContentPage>
