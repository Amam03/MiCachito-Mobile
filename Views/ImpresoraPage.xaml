<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MiCachito.Mobile.ViewModels"
    xmlns:s="clr-namespace:MiCachito.Mobile.Services"
    x:Class="MiCachito.Mobile.Views.ImpresoraPage"
    x:DataType="vm:ImpresoraViewModel"
    Title="Impresora"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource McPageBg}">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- ============ Header morado con flecha atrás (patrón DispositivosEnlazados) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="12,16"
            StrokeShape="RoundRectangle 0,0,12,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 18"
                    WidthRequest="36" HeightRequest="36">
                    <Grid>
                        <Label
                            Text="&#x2190;"
                            TextColor="White"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Button
                            BackgroundColor="Transparent"
                            Padding="0"
                            Command="{Binding VolverCommand}" />
                    </Grid>
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Impresora Bluetooth"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    VerticalOptions="Center" />

            </Grid>
        </Border>

        <!-- ============ Cuerpo ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Estado de la impresora seleccionada + Probar -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}"
                    Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label
                            Text="{Binding EstadoImpresora}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource McTextDark}"
                            VerticalOptions="Center" />
                        <Button
                            Text="Probar"
                            FontSize="13"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource McLotenalHeader}"
                            TextColor="{StaticResource White}"
                            CornerRadius="8"
                            HeightRequest="36"
                            Command="{Binding ProbarCommand}" />
                    </Grid>
                </Border>

                <!-- Mensaje de la prueba (vacío = oculto) -->
                <Label
                    Text="{Binding MensajePrueba}"
                    FontSize="13"
                    TextColor="{StaticResource McTextDark}"
                    HorizontalTextAlignment="Center" />

                <!-- Instrucción emparejamiento (flujo del SO) -->
                <Label
                    Text="Vincula la impresora desde Ajustes de Android (Bluetooth). Aquí solo se selecciona y se prueba."
                    FontSize="12"
                    TextColor="{StaticResource McGrayText}"
                    HorizontalTextAlignment="Center" />

                <!-- Lista de dispositivos vinculados reales -->
                <Label
                    Text="DISPOSITIVOS VINCULADOS"
                    FontSize="12"
                    FontAttributes="Bold"
                    TextColor="{StaticResource McGrayText}"
                    Margin="0,8,0,0" />

                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Dispositivos}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type s:DispositivoBluetooth}">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                Padding="16,14"
                                BackgroundColor="{StaticResource White}">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding DisplayName}"
                                    FontSize="15"
                                    TextColor="{StaticResource McTextDark}"
                                    VerticalOptions="Center" />
                                <Image
                                    Grid.Column="1"
                                    Source="icon_chevron_derecha_gris.svg"
                                    WidthRequest="18" HeightRequest="18"
                                    VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarDispositivoCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
