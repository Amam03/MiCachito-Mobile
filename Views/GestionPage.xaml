<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiCachito.Mobile.Views.GestionPage"
    Title="Gestion">

    <VerticalStackLayout
        Padding="30"
        Spacing="16"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Label
            Text="Gestion"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="{StaticResource McTextDark}"
            HorizontalOptions="Center" />

        <Label
            Text="Modulo en desarrollo"
            FontSize="16"
            TextColor="{StaticResource McPlaceholder}"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>