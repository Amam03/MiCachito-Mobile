<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MiCachito.Mobile.ViewModels"
    x:Class="MiCachito.Mobile.Views.ReportesPage"
    x:DataType="vm:ReportesViewModel"
    BackgroundColor="{StaticResource McPageBg}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- ============ Header azul (patrón Gestión) ============ -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource McPrimaryMorado}" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label
                    Grid.Column="0"
                    Text="←"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    Grid.Column="1"
                    Text="{Binding Title}"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />
                <Label
                    Grid.Column="2"
                    Text="•••"
                    FontSize="16"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <!-- ============ Contenido por pestaña ============ -->
        <Grid Grid.Row="1">

            <!-- ── Pestaña 1: Estado de Cuenta ── -->
            <ScrollView IsVisible="{Binding Pestana0Activa}">
                <VerticalStackLayout Padding="12,12,12,102" Spacing="10">

                    <!-- Estado inicial: botón Generar Reporte -->
                    <Border
                        IsVisible="{Binding SinReporte}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource McPrimaryMorado}"
                        StrokeThickness="0"
                        HeightRequest="48"
                        Margin="20,24,20,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GenerarReporteCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Generar Reporte"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Reporte generado: resumen de saldo -->
                    <Border
                        IsVisible="{Binding HayReporte}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="14,12"
                        Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Resumen de saldo" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="Fondo de Ahorro:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding FondoDeAhorro, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                                <Label Grid.Row="1" Grid.Column="0" Text="Fideicomiso:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Fideicomiso, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                                <Label Grid.Row="2" Grid.Column="0" Text="Pagarés:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Pagares, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                                <Label Grid.Row="3" Grid.Column="0" Text="Bolsa Electrónica:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding BolsaElectronica, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                                <Label Grid.Row="4" Grid.Column="0" Text="Garantía Total:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding GarantiaTotal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                                <Label Grid.Row="5" Grid.Column="0" Text="Capacidad de Crédito:" FontSize="13" TextColor="#1A1A1A" />
                                <Label Grid.Row="5" Grid.Column="1" Text="{Binding CapacidadDeCredito, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Reporte generado: listado de sorteos (estructura, sin registros) -->
                    <Border
                        IsVisible="{Binding HayReporte}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="14,12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sorteos" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label
                                Text="Sin registros"
                                FontSize="13"
                                TextColor="#9E9E9E"
                                IsVisible="{Binding SinSorteos}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Reporte generado: totales -->
                    <Border
                        IsVisible="{Binding HayReporte}"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="Vencido Total:" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding VencidoTotal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Consigna Total:" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ConsignaTotal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="2" Grid.Column="0" Text="Pagos Total:" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding PagosTotal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="3" Grid.Column="0" Text="Total Final:" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalFinal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Pestaña 2: Fondo de Ahorro ── -->
            <ScrollView IsVisible="{Binding Pestana1Activa}">
                <VerticalStackLayout Padding="12,12,12,170" Spacing="14">

                    <!-- Estado inicial: campo Periodo (abre el modal) -->
                    <Grid
                        IsVisible="{Binding SinFondo}"
                        ColumnDefinitions="*,Auto"
                        Margin="8,16,8,0"
                        Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirModalFechasCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Periodo" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Text="Indicar Periodo" FontSize="13" TextColor="{StaticResource McPrimaryMorado}" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Column="1"
                            Source="icon_calendario_azul.svg"
                            WidthRequest="22"
                            HeightRequest="22"
                            VerticalOptions="Center" />
                    </Grid>

                    <!-- Reporte consultado: periodo seleccionado (fechas reales del usuario).
                         Tap reabre el modal para re-consultar otro rango. -->
                    <VerticalStackLayout IsVisible="{Binding FondoConsultado}" Spacing="4" Margin="8,16,8,0">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirModalFechasCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="Periodo" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                        <Label Text="{Binding FechaDesdeLarga}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource McPrimaryMorado}" />
                        <Label Text="{Binding FechaHastaLarga}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource McPrimaryMorado}" />
                    </VerticalStackLayout>

                    <!-- Gráfica de rendimiento: estado SIN datos (línea base en $0.00 + cuadrícula tenue).
                         La serie real se dibujará aquí cuando existan movimientos. -->
                    <Grid
                        IsVisible="{Binding FondoConsultado}"
                        HeightRequest="140"
                        Margin="8,6,8,0">
                        <!-- Cuadrícula horizontal tenue -->
                        <BoxView Color="#E3E3E3" HeightRequest="1" VerticalOptions="Start" />
                        <BoxView Color="#E3E3E3" HeightRequest="1" VerticalOptions="Center" />
                        <BoxView Color="#E3E3E3" HeightRequest="1" VerticalOptions="End" />
                        <!-- Cuadrícula vertical tenue -->
                        <BoxView Color="#E3E3E3" WidthRequest="1" HorizontalOptions="Start" />
                        <BoxView Color="#E3E3E3" WidthRequest="1" HorizontalOptions="Center" />
                        <BoxView Color="#E3E3E3" WidthRequest="1" HorizontalOptions="End" />
                        <!-- Serie en cero: línea azul plana sobre la base -->
                        <BoxView Color="#3A4DBC" HeightRequest="2" VerticalOptions="End" />
                    </Grid>

                    <!-- Resumen de saldos (flat sobre el fondo, como el mockup 9.2) -->
                    <Grid
                        IsVisible="{Binding FondoConsultado}"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        Margin="8,10,8,0">
                        <Label Grid.Row="0" Grid.Column="0" Text="Saldo inicial:" FontSize="13" TextColor="#1A1A1A" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding FaSaldoInicial, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Depósitos:" FontSize="13" TextColor="#1A1A1A" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding FaDepositos, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Retiros:" FontSize="13" TextColor="#1A1A1A" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding FaRetiros, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Saldo final:" FontSize="13" TextColor="#1A1A1A" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding FaSaldoFinal, StringFormat='$ {0:N2}'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" />
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Pestaña 3: Facturación ── -->
            <ScrollView IsVisible="{Binding Pestana2Activa}">
                <VerticalStackLayout Padding="12,12,12,170" Spacing="14">

                    <!-- Estado inicial: campo Periodo (abre el modal) -->
                    <Grid
                        IsVisible="{Binding SinFac}"
                        ColumnDefinitions="*,Auto"
                        Margin="8,16,8,0"
                        Padding="0,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirModalFechasCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Periodo" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                            <Label Text="Indicar Periodo" FontSize="13" TextColor="{StaticResource McPrimaryMorado}" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Column="1"
                            Source="icon_calendario_azul.svg"
                            WidthRequest="22"
                            HeightRequest="22"
                            VerticalOptions="Center" />
                    </Grid>

                    <!-- Reporte consultado: periodo seleccionado (fechas reales del usuario).
                         Tap reabre el modal para re-consultar otro rango. -->
                    <VerticalStackLayout IsVisible="{Binding FacConsultado}" Spacing="4" Margin="8,16,8,0">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirModalFechasCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="Periodo" FontSize="14" FontAttributes="Bold" TextColor="#1A1A1A" />
                        <Label Text="{Binding FacDesdeLarga}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource McPrimaryMorado}" />
                        <Label Text="{Binding FacHastaLarga}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource McPrimaryMorado}" />
                    </VerticalStackLayout>

                    <!-- Métricas principales: Total facturado + porcentaje principal (dinámicos) -->
                    <VerticalStackLayout
                        IsVisible="{Binding FacConsultado}"
                        Spacing="2"
                        Margin="8,10,8,0"
                        HorizontalOptions="Center">
                        <Label Text="Total" FontSize="13" TextColor="#1A1A1A" HorizontalOptions="Center" />
                        <Label Text="{Binding FacTotal, StringFormat='$ {0:N2}'}" FontSize="22" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center" />
                        <Label Text="{Binding FacPorcentajePrincipal, StringFormat='{0:0.0}%'}" FontSize="13" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Gráfica circular por tipo de sorteo (proporciones dinámicas) -->
                    <GraphicsView
                        x:Name="PieFacturacion"
                        IsVisible="{Binding FacConsultado}"
                        HeightRequest="230"
                        WidthRequest="230"
                        HorizontalOptions="Center"
                        Margin="8,4,8,0" />

                    <!-- Leyenda: indicador de color + nombre, monto y porcentaje (dinámicos) -->
                    <FlexLayout
                        IsVisible="{Binding FacConsultado}"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        Margin="8,2,8,0"
                        x:Name="LeyendaFacturacion" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- Aviso verde: Fondo de Ahorro guardado en Descargas -->
            <Border
                IsVisible="{Binding AvisoFondoVisible}"
                StrokeThickness="0"
                BackgroundColor="#4CB050"
                VerticalOptions="End"
                Padding="14,10"
                SemanticProperties.Description="Aviso descarga Fondo de Ahorro">
                <Label
                    Text="Fondo de Ahorro guardado en la carpeta de Descargas"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            </Border>

            <!-- Aviso verde: Facturación guardada en Descargas -->
            <Border
                IsVisible="{Binding AvisoFacVisible}"
                StrokeThickness="0"
                BackgroundColor="#4CB050"
                VerticalOptions="End"
                Padding="14,10"
                SemanticProperties.Description="Aviso descarga Facturación">
                <Label
                    Text="Facturación guardada en la carpeta de Descargas"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            </Border>

            <!-- FAB descarga Estado de Cuenta (derecha, pestaña 1) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,18,18"
                IsVisible="{Binding FabDescargaEcVisible}"
                SemanticProperties.Description="Descargar reporte">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DescargarCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_descarga_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

            <!-- FAB PDF Estado de Cuenta (izquierda, pestaña 1) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="18,0,0,18"
                IsVisible="{Binding FabPdfEcVisible}"
                SemanticProperties.Description="Abrir PDF">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirPdfCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_pdf_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

            <!-- FAB descarga Fondo de Ahorro (derecha, pestaña 2) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,18,70"
                IsVisible="{Binding FabDescargaFaVisible}"
                SemanticProperties.Description="Descargar Fondo de Ahorro">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DescargarFondoCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_descarga_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

            <!-- FAB PDF Fondo de Ahorro (izquierda, pestaña 2) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="18,0,0,70"
                IsVisible="{Binding FabPdfFaVisible}"
                SemanticProperties.Description="Abrir PDF Fondo de Ahorro">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirPdfFondoCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_pdf_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

            <!-- FAB descarga Facturación (derecha, pestaña 3) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,18,70"
                IsVisible="{Binding FabDescargaFacVisible}"
                SemanticProperties.Description="Descargar Facturación">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DescargarFacCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_descarga_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

            <!-- FAB PDF Facturación (izquierda, pestaña 3) -->
            <Border
                StrokeShape="RoundRectangle 30"
                BackgroundColor="{StaticResource McPrimaryMorado}"
                StrokeThickness="0"
                WidthRequest="56" HeightRequest="56"
                HorizontalOptions="Start"
                VerticalOptions="End"
                Margin="18,0,0,70"
                IsVisible="{Binding FabPdfFacVisible}"
                SemanticProperties.Description="Abrir PDF Facturación">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirPdfFacCommand}" />
                </Border.GestureRecognizers>
                <Image
                    Source="icon_pdf_blanco.svg"
                    WidthRequest="24" HeightRequest="24" />
            </Border>

        </Grid>

        <!-- ============ Tab bar interna de Reportes ============ -->
        <Border
            Grid.Row="2"
            StrokeThickness="0"
            BackgroundColor="#FFFFFF"
            Stroke="Transparent">
            <Grid ColumnDefinitions="*,*,*">

                <VerticalStackLayout Grid.Column="0" Padding="0,8,0,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CambiarPestanaCommand}" CommandParameter="0" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image
                        Source="{Binding IconoPestana0}"
                        WidthRequest="24" HeightRequest="24"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Estado de Cuenta"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{Binding ColorPestana0}"
                        HorizontalOptions="Center"
                        Margin="0,3,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Padding="0,8,0,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CambiarPestanaCommand}" CommandParameter="1" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image
                        Source="{Binding IconoPestana1}"
                        WidthRequest="24" HeightRequest="24"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Fondo de Ahorro"
                        FontSize="11"
                        TextColor="{Binding ColorPestana1}"
                        HorizontalOptions="Center"
                        Margin="0,3,0,0" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Padding="0,8,0,6">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CambiarPestanaCommand}" CommandParameter="2" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Image
                        Source="{Binding IconoPestana2}"
                        WidthRequest="24" HeightRequest="24"
                        HorizontalOptions="Center" />
                    <Label
                        Text="Facturación"
                        FontSize="11"
                        TextColor="{Binding ColorPestana2}"
                        HorizontalOptions="Center"
                        Margin="0,3,0,0" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- ============ Modal Seleccionar Fechas (Fondo de Ahorro) ============ -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding ModalFechasVisible}"
            BackgroundColor="#80707070"
            StrokeThickness="0"
            Padding="0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalFechasCommand}" />
            </Border.GestureRecognizers>
            <Border
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="300"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="18,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CardModal_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Seleccionar Fechas"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource McPrimaryMorado}"
                        HorizontalOptions="Center" />

                    <!-- Campo Desde -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource McPageBg}"
                        Padding="12,10"
                        SemanticProperties.Description="Campo Desde">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirDesdeCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Desde" FontSize="11" TextColor="#757575" />
                            <Label Text="{Binding ModalDesdeTexto}" FontSize="14" TextColor="#1A1A1A" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Column="1"
                            Source="icon_calendario_azul.svg"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center" />
                    </Grid>

                    <!-- Campo Hasta -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource McPageBg}"
                        Padding="12,10"
                        SemanticProperties.Description="Campo Hasta">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirHastaCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Hasta" FontSize="11" TextColor="#757575" />
                            <Label Text="{Binding ModalHastaTexto}" FontSize="14" TextColor="#1A1A1A" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Column="1"
                            Source="icon_calendario_azul.svg"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center" />
                    </Grid>

                    <!-- Botón Consultar -->
                    <Border
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{StaticResource McPrimaryMorado}"
                        StrokeThickness="0"
                        HeightRequest="44"
                        IsEnabled="{Binding ModalPuedeConsultar}"
                        Opacity="{Binding OpacidadConsultar}"
                        SemanticProperties.Description="Consultar">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConsultarFondoCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="Consultar"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- ============ Overlay Procesando.... ============ -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding Procesando}"
            BackgroundColor="#80707070"
            StrokeThickness="0"
            Padding="0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40" />
                <Label
                    Text="Procesando...."
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- ============ Overlay Descargando.... ============ -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding Descargando}"
            BackgroundColor="#80707070"
            StrokeThickness="0"
            Padding="0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40" />
                <Label
                    Text="Descargando...."
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
