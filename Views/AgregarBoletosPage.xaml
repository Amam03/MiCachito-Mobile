<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.AgregarBoletosPage"
    Title="Agregar Boletos"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ==================== HEADER morado ==================== -->
        <!-- Flecha ← a la izquierda, título al centro, carrito blanco
             en la esquina superior derecha (mockups 9.1 / 9.2). -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <!-- Con el overlay 10.x abierto el header se oscurece
                 (mockups 10.1/10.2: #1C116F = morado atenuado por el
                 scrim; el resto de la pantalla queda bajo el scrim). -->
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding CantidadDialogoVisible}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource McHeaderDimmed}" />
                </DataTrigger>
            </Border.Triggers>

            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">

                <!-- Botón retroceso -->
                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#x2190;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- Título "Agregar Boletos" -->
                <Label
                    Grid.Column="1"
                    Text="Agregar Boletos"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <!-- Carrito del header (blanco, esquina superior derecha).
                     UI-only: función en la pantalla del carrito (futuro).
                     Badge "00" visible con el overlay 10.x abierto
                     (mockups 10.1/10.2) o con cantidades acumuladas. -->
                <Grid Grid.Column="2">
                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        HorizontalOptions="End"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CarritoHeaderCommand}" />
                        </Border.GestureRecognizers>
                        <Image
                            Source="icon_carrito_blanco.svg"
                            WidthRequest="24"
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Badge de cantidad (dos dígitos, "00" en 10.x) -->
                    <Border
                        IsVisible="{Binding MostrarBadgeCarrito}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        BackgroundColor="{StaticResource McLotenalHeader}"
                        Padding="6,1"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        TranslationX="-2"
                        TranslationY="2">
                        <Label
                            Text="{Binding CarritoBadgeTexto}"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource White}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ==================== CONTENIDO ==================== -->
        <Grid Grid.Row="1">

            <VerticalStackLayout>

                <!-- Fila filtro de signo (SOLO zodiaco / zodiaco especial):
                     muestra el filtro activo y despliega el selector. -->
                <Border
                    IsVisible="{Binding EsZodiaco}"
                    StrokeThickness="1"
                    Stroke="{StaticResource McDivider}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{StaticResource White}"
                    HeightRequest="46"
                    Margin="20,16,20,0"
                    Padding="16,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleSelectorSignoCommand}" />
                    </Border.GestureRecognizers>
                    <!-- Grupo texto + flecha pegada, alineado a la izquierda
                         (mockup 9.2: "Signo Aleatorio ▼" con la flecha
                         inmediatamente después del texto). -->
                    <HorizontalStackLayout
                        Spacing="8"
                        VerticalOptions="Center">
                        <Label
                            Text="{Binding SignoFiltroTexto}"
                            FontSize="16"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            TextColor="{StaticResource McTextDark}"
                            VerticalOptions="Center" />
                        <Label
                            Text="&#x25BC;"
                            FontSize="12"
                            TextColor="{StaticResource McTextDark}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- ============ LISTA DE TIENDAS / BOLETOS ============ -->
                <!-- Normal (9.1): número + fracciones / ciudad, estado.
                     Zodiaco (9.2): añade la línea de SIGNO entre ambas.
                     Botón carrito oscuro a la derecha de cada fila. -->
                <CollectionView
                    ItemsSource="{Binding Tiendas}"
                    SelectionMode="None"
                    BackgroundColor="{StaticResource White}"
                    Margin="20,16,20,0">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:TiendaDisponible">

                            <Border
                                StrokeThickness="1"
                                Stroke="{StaticResource McDivider}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                Margin="0,0,0,10"
                                Padding="16,10,10,10">

                                <Grid ColumnDefinitions="*,Auto">

                                    <!-- Info del boleto -->
                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        VerticalOptions="Center"
                                        Spacing="2">

                                        <!-- Línea 1: número + fracciones vivas
                                             (0/20 → 1/20 al aceptar) -->
                                        <HorizontalStackLayout Spacing="12">
                                            <Label
                                                Text="{Binding Numero}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                FontFamily="OpenSansSemibold"
                                                TextColor="{StaticResource McTextDark}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding FraccionesDisplay}"
                                                FontSize="13"
                                                TextColor="{StaticResource McTextDark}"
                                                Opacity="0.65"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Línea 2 (solo zodiaco): SIGNO -->
                                        <Label
                                            Text="{Binding Signo}"
                                            IsVisible="{Binding MostrarSigno}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            TextColor="{StaticResource McTextDark}"
                                            HorizontalOptions="Start" />

                                        <!-- Línea final: ciudad, estado -->
                                        <Label
                                            Text="{Binding DisplayName}"
                                            FontSize="13"
                                            TextColor="{StaticResource McTextDark}"
                                            Opacity="0.8"
                                            HorizontalOptions="Start"
                                            LineBreakMode="WordWrap" />

                                    </VerticalStackLayout>

                                    <!-- Botón carrito por fila (oscuro).
                                         UI-only: navegará a la pantalla 10.x
                                         (cantidad de boletos) en el futuro. -->
                                    <Border
                                        Grid.Column="1"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CarritoTiendaCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Image
                                            Source="icon_carrito_oscuro.svg"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

            <!-- ============ SELECTOR DE SIGNOS (overlay, solo zodiaco) ============ -->
            <!-- Cubre el contenido bajo el header (mockup 9.2 panel central):
                 13 filas de texto centrado, "Signo Aleatorio" primero
                 (mismo estilo que la pantalla 8). -->
            <Grid
                IsVisible="{Binding SelectorSignoVisible}"
                BackgroundColor="{StaticResource White}"
                Padding="0,12,0,0">

                <!-- Tocar fuera de las opciones cierra el selector sin
                     cambiar el filtro (los Border de las opciones capturan
                     su propio tap y este gesture no se dispara). -->
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CerrarSelectorSignoCommand}" />
                </Grid.GestureRecognizers>

                <CollectionView
                    ItemsSource="{Binding Signos}"
                    SelectionMode="None"
                    BackgroundColor="{StaticResource White}"
                    Margin="20,0,20,0">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:SignoZodiaco">

                            <Border
                                StrokeThickness="1"
                                Stroke="{StaticResource McDivider}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource White}"
                                HeightRequest="52"
                                Margin="0,0,0,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarSignoCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource McTextDark}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

            <!-- ============ OVERLAY 10.x: CANTIDAD DE CACHITOS ============ -->
            <!-- Mockups 10.1/10.2: scrim oscuro sobre TODO el contenido,
                 diálogo blanco centrado ("Cantidad de / Cachitos",
                 campo subrayado + disponibles a la derecha, Cancelar /
                 Aceptar), franja de círculos, y teclado numérico con
                 "Realiz." abajo. El badge "00" aparece junto al carrito
                 del header. Toast inferior solo tras "Realiz."
                 (10.2: "AQUÍ ELEGIRÁS 5 DE 16 / DISPONIBLES"). -->
            <Grid
                IsVisible="{Binding CantidadDialogoVisible}"
                BackgroundColor="{StaticResource McScrimBlack55}">

                <!-- Tocar el scrim cierra el overlay (mismo patrón del
                     selector de signos: salida alternativa de cierre). -->
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelarCantidadCommand}" />
                </Grid.GestureRecognizers>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    Margin="24,0"
                    InputTransparent="False">

                    <!-- ============ Diálogo Cantidad de Cachitos ============ -->
                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource White}"
                        Padding="0,20,0,16"
                        HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="0">

                            <!-- Título 2 líneas, negro, centrado -->
                            <Label
                                Text="Cantidad de"
                                FontSize="16"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource McTextDark}"
                                HorizontalOptions="Center" />
                            <Label
                                Text="Cachitos"
                                FontSize="16"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                TextColor="{StaticResource McTextDark}"
                                HorizontalOptions="Center" />

                            <!-- Campo subrayado + disponibles a la derecha
                                 (mockups: "20"/"16" en gris claro).
                                 Placeholder "1" gris claro cuando está
                                 vacío (10.2 tras Realiz.). -->
                            <Grid
                                ColumnDefinitions="80,*"
                                Margin="16,24,16,0"
                                HorizontalOptions="Fill">
                                <Grid Grid.Column="0"
                                      ColumnDefinitions="*,Auto">
                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding CantidadTexto}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{StaticResource McTextDark}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <!-- Subrayado del campo -->
                                    <BoxView
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HeightRequest="2"
                                        BackgroundColor="{StaticResource McDialogFieldLine}"
                                        VerticalOptions="End"
                                        HorizontalOptions="Fill" />
                                </Grid>

                                <!-- Disponibles de la fila (derivado de
                                     fracciones, NO hardcoded) -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DisponiblesTexto}"
                                    FontSize="18"
                                    TextColor="{StaticResource McDialogHint}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Start"
                                    Margin="12,0,0,0" />
                            </Grid>

                            <!-- Cancelar (borde blanco, texto rojo) /
                                 Aceptar (verde, texto blanco) -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="12"
                                Margin="16,24,16,0"
                                HorizontalOptions="Fill">

                                <Border
                                    Grid.Column="0"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource McRedCancel}"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{StaticResource White}"
                                    HeightRequest="40"
                                    HorizontalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CancelarCantidadCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Cancelar"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{StaticResource McRedCancel}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource McGreenAccept}"
                                    HeightRequest="40"
                                    HorizontalOptions="Fill">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AceptarCantidadCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="Aceptar"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{StaticResource White}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ============ Franja de círculos (chips) ============ -->
                    <!-- Mockup: 5 círculos beige sobre franja #EFF0EA
                         entre diálogo y teclado. Contenido ilegible en
                         OCR (¿números de fracciones?): se dejan como
                         círculos vacíos, documentado en NOTAS. Solo
                         visible con el teclado desplegado. -->
                    <Border
                        IsVisible="{Binding TecladoVisible}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0"
                        BackgroundColor="{StaticResource McStripBg}"
                        Margin="0,12,0,0"
                        Padding="12,10"
                        HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Ellipse
                                StrokeThickness="0"
                                Fill="{StaticResource McStripDot}"
                                WidthRequest="26" HeightRequest="26" />
                            <Ellipse
                                StrokeThickness="0"
                                Fill="{StaticResource McStripDot}"
                                WidthRequest="26" HeightRequest="26" />
                            <Ellipse
                                StrokeThickness="0"
                                Fill="{StaticResource McStripDot}"
                                WidthRequest="26" HeightRequest="26" />
                            <Ellipse
                                StrokeThickness="0"
                                Fill="{StaticResource McStripDot}"
                                WidthRequest="26" HeightRequest="26" />
                            <Ellipse
                                StrokeThickness="0"
                                Fill="{StaticResource McStripDot}"
                                WidthRequest="18" HeightRequest="18"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- ============ Teclado numérico (formato teléfono, 4 filas) ============ -->
                    <!-- Teclas #FCFCFA sobre fondo #E3E3D9. Fila 4: Borrar
                         (beige), 0, Realizado (beige). "Realizado" OCULTA
                         el teclado (el diálogo queda a la vista con
                         Aceptar junto a la fila). -->
                    <Border
                        IsVisible="{Binding TecladoVisible}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0"
                        BackgroundColor="{StaticResource McKeyboardBg}"
                        Margin="0,12,0,0"
                        Padding="10,10,10,12"
                        HorizontalOptions="Fill">

                        <Grid
                            RowDefinitions="*,*,*,*"
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="10"
                            RowSpacing="10"
                            HeightRequest="248">

                            <!-- Fila 1: 1 2 3 -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="1" />
                                </Border.GestureRecognizers>
                                <Label Text="1" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="2" />
                                </Border.GestureRecognizers>
                                <Label Text="2" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="3" />
                                </Border.GestureRecognizers>
                                <Label Text="3" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Fila 2: 4 5 6 -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="4" />
                                </Border.GestureRecognizers>
                                <Label Text="4" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="5" />
                                </Border.GestureRecognizers>
                                <Label Text="5" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="6" />
                                </Border.GestureRecognizers>
                                <Label Text="6" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Fila 3: 7 8 9 -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="7" />
                                </Border.GestureRecognizers>
                                <Label Text="7" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="8" />
                                </Border.GestureRecognizers>
                                <Label Text="8" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="9" />
                                </Border.GestureRecognizers>
                                <Label Text="9" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <!-- Fila 4: Borrar 0 Realizado -->
                            <Border Grid.Row="3" Grid.Column="0"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadBeige}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BorrarDigitoCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Borrar" FontSize="14" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadKey}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TeclaCommand}" CommandParameter="0" />
                                </Border.GestureRecognizers>
                                <Label Text="0" FontSize="20" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource McKeypadBeige}"
                                    HeightRequest="52">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RealizadoCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Realizado" FontSize="13" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Grid>

            <!-- ============ TOAST 10.2 (tras "Realiz.") ============ -->
            <!-- Banner blanco de 2 líneas sobre la parte inferior
                 (mockup 10.2): "AQUÍ ELEGIRÁS 5 DE 16 / DISPONIBLES".
                 Visible solo mientras el overlay está abierto y la
                 cantidad fue confirmada. -->
            <Border
                IsVisible="{Binding ToastCantidadVisible}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{StaticResource White}"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Padding="16,10,16,10"
                InputTransparent="True">
                <VerticalStackLayout>
                    <Label
                        Text="{Binding ToastLinea1}"
                        FontSize="14"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource McTextDark}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="DISPONIBLES"
                        FontSize="14"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource McTextDark}"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
