<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiCachito.Mobile.Views.VentaExitosaLotenalPage"
    Title="Venta Exitosa"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <!-- Patrón aprobado de VentaExitosaTec (círculo verde con check,
         botón Continuar al Home) + datos REALES de la venta (F3):
         folio, total y boletos devueltos por el backend. -->
    <VerticalStackLayout
        Padding="30,0,30,0"
        Spacing="24"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <!-- Círculo verde con check -->
        <Border
            StrokeThickness="0"
            StrokeShape="RoundRectangle 48"
            BackgroundColor="{StaticResource McGreenAccept}"
            WidthRequest="96"
            HeightRequest="96"
            HorizontalOptions="Center">
            <Image
                Source="icon_check_blanco.svg"
                WidthRequest="48"
                HeightRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- Título -->
        <Label
            Text="Venta Exitosa"
            FontSize="24"
            FontAttributes="Bold"
            FontFamily="OpenSansSemibold"
            TextColor="{StaticResource McTextDark}"
            HorizontalOptions="Center" />

        <!-- Datos reales de la venta (backend) -->
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
            <Label
                Text="{Binding Folio}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{StaticResource McPrimaryMorado}"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding TotalTexto}"
                FontSize="20"
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                TextColor="{StaticResource McTextDark}"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding BoletosTexto}"
                FontSize="14"
                TextColor="{StaticResource McGrayText}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Botón Continuar -->
        <Border
            StrokeThickness="0"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="{StaticResource McGreen}"
            HeightRequest="50"
            WidthRequest="200"
            HorizontalOptions="Center">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ContinuarCommand}" />
            </Border.GestureRecognizers>
            <Label
                Text="Continuar"
                FontSize="16"
                FontAttributes="Bold"
                FontFamily="OpenSansSemibold"
                TextColor="{StaticResource White}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

    </VerticalStackLayout>

</ContentPage>
