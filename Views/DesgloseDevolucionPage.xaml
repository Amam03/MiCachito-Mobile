<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    xmlns:vm="clr-namespace:MiCachito.Mobile.ViewModels"
    x:Class="MiCachito.Mobile.Views.DesgloseDevolucionPage"
    x:DataType="vm:DesgloseDevolucionViewModel"
    Title="Desglose"
    BackgroundColor="{StaticResource McFieldBg}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ============ HEADER morado "[Modo] Capturados (N)" + back ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                <Grid Row="0" ColumnDefinitions="44,*,44">
                    <Border
                        Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        WidthRequest="44"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="&#x2190;"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="{StaticResource White}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        Text="{Binding TituloDesglose}"
                        FontSize="18"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    Grid.Row="1"
                    Text="{Binding NombreSorteo}"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{StaticResource McSuccess}"
                    HorizontalOptions="Center" />
            </Grid>
        </Border>

        <!-- ============ Tabla del desglose ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,16,16,24"
                Spacing="10"
                VerticalOptions="Start">

                <Label
                    IsVisible="{Binding HayFilasInverso}"
                    Text="Sin capturas en este modo"
                    FontSize="14"
                    TextColor="{StaticResource McPlaceholder}"
                    HorizontalOptions="Center"
                    Margin="0,30,0,0" />

                <!-- Encabezados de tabla (mockup 6.2 desglose) -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource McLotenalHeader}"
                    Padding="14,10">
                    <Grid ColumnDefinitions="*,90,80,60">
                        <Label Grid.Column="0" Text="Billete" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource White}" />
                        <Label Grid.Column="1" Text="Cantidad" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource White}" HorizontalOptions="Center" />
                        <Label Grid.Column="2" Text="Vigésimo" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource White}" HorizontalOptions="Center" />
                        <Label Grid.Column="3" Text="Serie" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource White}" HorizontalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Filas capturadas -->
                <VerticalStackLayout
                    Spacing="6"
                    BindableLayout.ItemsSource="{Binding Filas}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="entities:FilaDesglose">
                            <Border
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource White}"
                                Padding="14,10">
                                <Grid ColumnDefinitions="*,90,80,60">
                                    <Label Grid.Column="0" Text="{Binding Billete}" FontSize="14" TextColor="{StaticResource McTextDark}" />
                                    <Label Grid.Column="1" Text="{Binding Cantidad}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource McTextDark}" HorizontalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Vigesimo}" FontSize="14" TextColor="{StaticResource McTextDark}" HorizontalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Serie}" FontSize="14" TextColor="{StaticResource McTextDark}" HorizontalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
