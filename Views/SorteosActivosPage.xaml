<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.SorteosActivosPage"
    Title="Numero de Sorteo"
    BackgroundColor="{StaticResource White}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ==================== HEADER morado ==================== -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">

                <!-- Botón retroceso -->
                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#x2190;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- Título "Numero de Sorteo" -->
                <Label
                    Grid.Column="1"
                    Text="Numero de Sorteo"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </Grid>
        </Border>

        <!-- ==================== LISTA DE SORTEOS ACTIVOS ==================== -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding SorteosActivos}"
            SelectionMode="None"
            BackgroundColor="{StaticResource White}"
            Margin="20,16,20,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:SorteoActivoLotenal">

                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{Binding ColorHex}"
                        HeightRequest="80"
                        Padding="20,0"
                        Margin="0,0,0,10">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarSorteoActivoCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="2" VerticalOptions="Center">

                            <!-- Fila 1: nombre del sorteo (izq) + precio (der) -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    VerticalOptions="Center"
                                    Spacing="0">
                                    <Label
                                        Text="{Binding Linea1}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource White}"
                                        HorizontalOptions="Start" />
                                    <Label
                                        Text="{Binding Linea2}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{StaticResource White}"
                                        HorizontalOptions="Start" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DisplayPrecio}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <!-- Fila 2: No. de sorteo (izq) + fecha (der) -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <Label
                                    Grid.Column="0"
                                    Text="{Binding DisplayNumero}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource White}"
                                    HorizontalOptions="Start"
                                    Opacity="0.9" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding FechaSorteoTexto}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource White}"
                                    HorizontalOptions="End"
                                    Opacity="0.9" />
                            </Grid>

                        </Grid>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
