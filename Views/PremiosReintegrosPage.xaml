<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.PremiosReintegrosPage"
    Title="Premios y Reintegros"
    BackgroundColor="{StaticResource McFieldBg}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ============ HEADER morado (patron LOTENAL) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,14,16,14">

            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">

                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#x2190;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Premios y Reintegros"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </Grid>
        </Border>

        <!-- ============ RESUMEN 3 columnas (mockup 3) ============ -->
        <Border
            Grid.Row="1"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            Padding="16,0,16,14">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                <StackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Total" FontSize="12" TextColor="#D9D2FF"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding TotalGeneralText}" FontSize="16"
                           FontAttributes="Bold" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" />
                </StackLayout>

                <StackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Premios" FontSize="12" TextColor="#D9D2FF"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding TotalPremiosText}" FontSize="16"
                           FontAttributes="Bold" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" />
                </StackLayout>

                <StackLayout Grid.Column="2" Spacing="2">
                    <Label Text="Reintegros" FontSize="12" TextColor="#D9D2FF"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding TotalReintegrosText}" FontSize="16"
                           FontAttributes="Bold" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}"
                           HorizontalTextAlignment="Center" />
                </StackLayout>

            </Grid>
        </Border>

        <!-- ============ LISTADO de movimientos ============ -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Movimientos}"
            SelectionMode="None"
            Margin="16,14,16,90">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:MovimientoPremiosReintegros">

                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource White}"
                        Padding="16,14,16,14"
                        Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AbrirDetalleCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Folio, StringFormat='Folio {0}'}"
                                       FontSize="16" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McTextDark}" />
                                <Label Text="{Binding Fecha}"
                                       FontSize="13"
                                       TextColor="{StaticResource McGrayText}" />
                            </StackLayout>

                            <StackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Total"
                                       FontSize="11"
                                       TextColor="{StaticResource McGrayText}"
                                       HorizontalTextAlignment="End" />
                                <Label Text="{Binding Total, StringFormat='${0:0.00}'}"
                                       FontSize="15" FontAttributes="Bold"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource McLotenalHeader}"
                                       HorizontalTextAlignment="End" />
                            </StackLayout>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- ============ FAB "+" (esquina inferior derecha, mockup 3) ============ -->
        <Border
            Grid.Row="2"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 28"
            BackgroundColor="#304FFF"
            WidthRequest="56"
            HeightRequest="56"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AgregarCommand}" />
            </Border.GestureRecognizers>
            <Label
                Text="+"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="{StaticResource White}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

    </Grid>
</ContentPage>
