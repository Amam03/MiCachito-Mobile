<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MiCachito.Mobile.ViewModels"
    xmlns:m="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.ExpendiosPage"
    x:DataType="vm:ExpendiosViewModel"
    BackgroundColor="{StaticResource McPageBg}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- ============ Encabezado: Saldo (patrón Gestión, mockup Expendios 1) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            BackgroundColor="{StaticResource McLotenalHeader}"
            HeightRequest="64"
            Padding="20,0">
            <StackLayout
                Orientation="Horizontal"
                Spacing="6"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label
                    Text="Saldo:"
                    FontSize="18"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding Saldo}"
                    FontSize="18"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource McGesSaldoVerde}"
                    VerticalOptions="Center" />
            </StackLayout>
        </Border>

        <!-- ============ Banda de pestañas del módulo (indigo, solo iconos) ============ -->
        <Grid
            Grid.Row="1"
            BackgroundColor="#283593"
            HeightRequest="48"
            ColumnDefinitions="*,*">

            <Grid Grid.Column="0">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CambiarPestanaCommand}" CommandParameter="0" />
                </Grid.GestureRecognizers>
                <Image
                    Source="{Binding IconoPestana0}"
                    WidthRequest="24" HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Consulta de registros" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CambiarPestanaCommand}" CommandParameter="1" />
                </Grid.GestureRecognizers>
                <Image
                    Source="{Binding IconoPestana1}"
                    WidthRequest="24" HeightRequest="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Administración de expendios" />
            </Grid>

        </Grid>

        <!-- ============ Contenido ============ -->
        <Grid Grid.Row="2">

            <!-- ── Pestaña 1: Consulta de registros (mockups 1-3) ── -->
            <ScrollView IsVisible="{Binding Pestana0Activa}">
                <VerticalStackLayout Padding="16,16,16,24" Spacing="14">

                    <!-- Periodo + acciones calendario/impresora -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="Periodo" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource McTextDark}" />
                            <Label Text="{Binding PeriodoTexto}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource McPrimaryMorado}" />
                        </VerticalStackLayout>
                        <Image
                            Grid.Column="1"
                            Source="icon_calendario_azul.svg"
                            WidthRequest="24" HeightRequest="24"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Seleccionar fechas y expendios">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AbrirModalFechasCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Image
                            Grid.Column="2"
                            Source="icon_impresora_morado.svg"
                            WidthRequest="24" HeightRequest="24"
                            VerticalOptions="Center"
                            SemanticProperties.Description="Imprimir resultado">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ImprimirCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- Estado vacío: Sin Registros (mockup 3; los registros reales llegarán con el backend) -->
                    <Border
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="14,18"
                        Margin="0,10,0,0">
                        <Label
                            Text="Sin Registros"
                            FontSize="14"
                            TextColor="{StaticResource McPlaceholderGris}"
                            HorizontalOptions="Center" />
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Pestaña 2: Administración de expendios (mockup 4) ── -->
            <Grid IsVisible="{Binding Pestana1Activa}">

                <ScrollView Padding="16,16,16,96">
                    <CollectionView ItemsSource="{Binding Expendios}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:Expendio">
                                <Border
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    Padding="14,14"
                                    Margin="0,0,0,12"
                                    SemanticProperties.Description="Expendio">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="4" ColumnSpacing="12">

                                        <!-- Icono de expendio -->
                                        <Image
                                            Grid.Row="0" Grid.RowSpan="4" Grid.Column="0"
                                            Source="icon_tienda_morado.svg"
                                            WidthRequest="34" HeightRequest="34"
                                            VerticalOptions="Start"
                                            Margin="0,2,0,0" />

                                        <Label
                                            Grid.Row="0" Grid.Column="1"
                                            Text="{Binding Alias}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            TextColor="{StaticResource McTextDark}" />

                                        <Label
                                            Grid.Row="1" Grid.Column="1"
                                            Text="{Binding Nombre}"
                                            FontSize="13"
                                            TextColor="{StaticResource McTextBody}"
                                            LineBreakMode="WordWrap" />

                                        <Label
                                            Grid.Row="2" Grid.Column="1"
                                            Text="{Binding Domicilio}"
                                            FontSize="13"
                                            TextColor="{StaticResource McTextBody}"
                                            LineBreakMode="WordWrap" />

                                        <!-- Botón editar (lápiz) -->
                                        <Image
                                            Grid.Row="3" Grid.Column="1"
                                            Source="icon_lapiz_indigo.svg"
                                            WidthRequest="22" HeightRequest="22"
                                            HorizontalOptions="End"
                                            Margin="0,8,0,0"
                                            SemanticProperties.Description="Actualizar expendio">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                <!-- FAB + (crear expendio) -->
                <Border
                    StrokeShape="RoundRectangle 30"
                    BackgroundColor="{StaticResource McLotenalHeader}"
                    StrokeThickness="0"
                    WidthRequest="56" HeightRequest="56"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,18,24"
                    SemanticProperties.Description="Crear expendio">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CrearCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="+"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

            </Grid>

        </Grid>

        <!-- ============ Modal Seleccionar Fechas y Expendios (mockup 2) ============ -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding ModalFechasVisible}"
            BackgroundColor="#80313131"
            StrokeThickness="0"
            Padding="0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CerrarModalFechasCommand}" />
            </Border.GestureRecognizers>
            <Border
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="300"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Padding="18,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="CardModal_Tapped" />
                </Border.GestureRecognizers>
                <!-- SIN ScrollView exterior: dentro de una card centrada, un
                     ScrollView con altura disponible finita reporta TODO ese
                     alto (no mide contenido) y estira la card a casi pantalla
                     completa. La card envuelve su contenido directamente;
                     solo la lista de expendios scrollea (tope por si hay
                     muchos), así Consultar queda pegado a la lista. -->
                <VerticalStackLayout Spacing="16">

                    <Label
                        Text="Seleccionar Fechas"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource McPrimaryMorado}"
                        HorizontalOptions="Center" />

                    <!-- Campo Desde -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        BackgroundColor="{StaticResource McPageBg}"
                        Padding="12,10"
                        SemanticProperties.Description="Campo Desde">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ElegirDesdeCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Desde" FontSize="11" TextColor="#757575" />
                            <Label Text="{Binding DesdeTexto}" FontSize="14" TextColor="{StaticResource McTextDark}" />
                            </VerticalStackLayout>
                            <Image
                                Grid.Column="1"
                                Source="icon_calendario_azul.svg"
                                WidthRequest="20" HeightRequest="20"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Campo Hasta -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            BackgroundColor="{StaticResource McPageBg}"
                            Padding="12,10"
                            SemanticProperties.Description="Campo Hasta">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ElegirHastaCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Hasta" FontSize="11" TextColor="#757575" />
                                <Label Text="{Binding HastaTexto}" FontSize="14" TextColor="{StaticResource McTextDark}" />
                            </VerticalStackLayout>
                            <Image
                                Grid.Column="1"
                                Source="icon_calendario_azul.svg"
                                WidthRequest="20" HeightRequest="20"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Expendios asociados (dinámico: uno o varios, con checkbox).
                             BindableLayout (NO CollectionView): dentro de un modal con
                             ScrollView, CollectionView no mide su contenido en Android
                             y estira el recuadro; BindableLayout ajusta la altura al
                             número de expendios, dejando Consultar justo debajo. -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Expendios" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource McTextDark}" />
                            <!-- ScrollView con tope SOLO en la lista: crece con los
                                 expendios pero nunca estira la card de forma fija -->
                            <ScrollView MaximumHeightRequest="280">
                                <StackLayout BindableLayout.ItemsSource="{Binding Expendios}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:Expendio">
                                        <Grid ColumnDefinitions="*,Auto" Padding="4,6">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AlternarExpendioCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                <Label Text="{Binding Alias}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource McTextDark}" />
                                                <Label Text="{Binding Nombre}" FontSize="11" TextColor="{StaticResource McGrayText}" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Image
                                                Grid.Column="1"
                                                IsVisible="{Binding SeleccionadoConsulta}"
                                                Source="icon_caja_marcada_indigo.svg"
                                                WidthRequest="22" HeightRequest="22"
                                                VerticalOptions="Center" />
                                            <Image
                                                Grid.Column="1"
                                                IsVisible="{Binding NoSeleccionadoConsulta}"
                                                Source="icon_caja_vacia_gris.svg"
                                                WidthRequest="22" HeightRequest="22"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </ScrollView>
                        </VerticalStackLayout>

                        <!-- Botón Consultar (indigo del mockup 2) -->
                        <Border
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="#3F51B6"
                            StrokeThickness="0"
                            HeightRequest="44"
                            IsEnabled="{Binding PuedeConsultar}"
                            Opacity="{Binding OpacidadConsultar}"
                            SemanticProperties.Description="Consultar">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConsultarCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="Consultar"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                    </VerticalStackLayout>
            </Border>
        </Border>

        <!-- ============ Overlay Procesando... (patrón Reportes) ============ -->
        <Border
            Grid.Row="0" Grid.RowSpan="3"
            IsVisible="{Binding Procesando}"
            BackgroundColor="#80313131"
            StrokeThickness="0"
            Padding="0">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="14">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="40" HeightRequest="40" />
                <Label
                    Text="Procesando..."
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
