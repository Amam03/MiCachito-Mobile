<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:MiCachito.Mobile.Models.Entities"
    x:Class="MiCachito.Mobile.Views.SorteosLotenalPage"
    Title="LOTENAL"
    BackgroundColor="{StaticResource White}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Encabezado morado -->
            <Border
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0"
                BackgroundColor="{StaticResource McLotenalHeader}"
                Padding="0,18,0,18">
                <Label
                    Text="Seleccionar Sorteo"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center" />
            </Border>

            <!-- Lista de sorteos -->
            <CollectionView
                ItemsSource="{Binding Sorteos}"
                SelectionMode="None"
                Margin="20,16,20,0">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:SorteoLotenal">

                        <Border
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{Binding ColorHex}"
                            HeightRequest="64"
                            Padding="20,0"
                            Margin="0,0,0,10">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeleccionarSorteoCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto">
                                <!-- Nombre del sorteo (dos líneas) -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    VerticalOptions="Center"
                                    Spacing="0">
                                    <Label
                                        Text="{Binding Linea1}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource White}"
                                        HorizontalOptions="Start" />
                                    <Label
                                        Text="{Binding Linea2}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemibold"
                                        TextColor="{StaticResource White}"
                                        HorizontalOptions="Start" />
                                </VerticalStackLayout>

                                <!-- Precio -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding DisplayPrecio}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
