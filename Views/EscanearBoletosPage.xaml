<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MiCachito.Mobile.Controls"
    x:Class="MiCachito.Mobile.Views.EscanearBoletosPage"
    Title="Escanear Boletos"
    BackgroundColor="{StaticResource McPremioFondoOscuro}"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ============ HEADER morado oscuro (mockup 3.3 escaneo) ============ -->
        <Border
            Grid.Row="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 0"
            BackgroundColor="{StaticResource McHeaderDimmed}"
            Padding="16,14,16,14">

            <Grid ColumnDefinitions="44,*,44" VerticalOptions="Center">

                <Border
                    Grid.Column="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="Transparent"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#x2190;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    Text="Escanear Boletos"
                    FontSize="20"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    TextColor="{StaticResource White}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />

            </Grid>
        </Border>

        <!-- ============ CUERPO: camara + acumulado + dialogo ============ -->
        <Grid Grid.Row="1">

            <ScrollView>
                <VerticalStackLayout Padding="20,18,20,24" Spacing="14">

                    <!-- Camara integrada (preview + deteccion en vivo) -->
                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource McPremioPanelOscuro}"
                        HeightRequest="240"
                        Padding="0">
                        <Grid>
                            <controls:CameraScannerView
                                x:Name="Escaner"
                                DetectionCommand="{Binding CodigoDetectadoCommand}"
                                IsScanning="{Binding CamaraLista}"
                                TorchOn="{Binding LinternaEncendida}" />
                            <Border
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource McLotenalHeader}"
                                WidthRequest="170"
                                HeightRequest="170"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True" />
                            <Border
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                BackgroundColor="#B3000000"
                                WidthRequest="36"
                                HeightRequest="36"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,10,10,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleLinternaCommand}" />
                                </Border.GestureRecognizers>
                                <Image
                                    Source="icon_linterna_blanco.svg"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Text="Permiso de camara no concedido. Puedes capturar el codigo a mano."
                                TextColor="{StaticResource White}"
                                FontSize="13"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Margin="20,0,20,0"
                                IsVisible="{Binding PermisoDenegado}" />
                        </Grid>
                    </Border>

                    <!-- Aviso (invalido / duplicado / permiso) -->
                    <Label
                        Text="{Binding Aviso}"
                        TextColor="{StaticResource McPremioRojo}"
                        FontSize="13"
                        HorizontalTextAlignment="Center" />

                    <!-- Entrada manual (via de prueba en emulador) -->
                    <Label
                        Text="O captura el codigo a mano:"
                        FontSize="13"
                        TextColor="#D6D6D6" />
                    <Entry
                        x:Name="CampoManual"
                        Text="{Binding CodigoManual}"
                        Placeholder="34 o 35 digitos / SE051B032127"
                        Keyboard="Plain"
                        ReturnType="Done"
                        ReturnCommand="{Binding ConsultarManualCommand}"
                        ClearButtonVisibility="WhileEditing" />

                    <!-- Acumulado de la captura en curso (escaneo continuo) -->
                    <Label
                        Text="Boletos acumulados en el movimiento:"
                        FontSize="13"
                        TextColor="#D6D6D6"
                        Margin="0,6,0,0" />
                    <Label
                        Text="{Binding AcumuladoText}"
                        FontSize="15"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource White}" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ============ DIALOGO de resultado (mockup 3.3 escaneo) ============ -->
            <!-- Scrim: tocar fuera cierra SIN agregar (salida alternativa) -->
            <Grid IsVisible="{Binding DialogoVisible}" BackgroundColor="{StaticResource McScrimBlack55}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CerrarDialogoCommand}" />
                </Grid.GestureRecognizers>

                <!-- Tarjeta centrada (patron dialogo Atencion) -->
                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource White}"
                    WidthRequest="260"
                    HeightRequest="150"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    InputTransparent="False">
                    <VerticalStackLayout Spacing="14" VerticalOptions="Center" Padding="18,0,18,0">
                        <Label
                            Text="Atencion"
                            FontSize="16"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            TextColor="{StaticResource McTextDark}"
                            HorizontalOptions="Center" />
                        <Label
                            Text="{Binding MensajeDialogo}"
                            FontSize="17"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            TextColor="{Binding ColorAceptar}"
                            HorizontalTextAlignment="Center" />
                        <Button
                            Text="ACEPTAR"
                            Command="{Binding AceptarCommand}"
                            BackgroundColor="{Binding ColorAceptar}"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            HeightRequest="42"
                            CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>
